# Multi-Agent Swarm Project Configuration
# Copy this file to .env and adjust paths as needed

# Root directory of the multi-agent workspace
PROJECT_ROOT=/run/media/hamid/20C4138FC41365F61/Projects/multiagent

# Subproject paths (relative to PROJECT_ROOT)
SIMA_PROJECT_PATH=projects/sima
CANDASH_PROJECT_PATH=projects/candash
OMR_PROJECT_PATH=projects/omr

# State directory partitions
SIMA_STATE_PATH=state/sima
CANDASH_STATE_PATH=state/candash
SHARED_STATE_PATH=state/shared

# Canonical state file
STATE_PATH=state

# Docker Compose
COMPOSE_PROJECT_NAME=multiagent
COMPOSE_FILE=docker-compose.yml

# Coordination branch for GitOps
COORDINATION_BRANCH=master

# Lease TTL in seconds (dashboard API: 120s, agent worker: 900s)
LEASE_TTL_SECONDS=120
AGENT_LEASE_TTL_SECONDS=900
AGENT_LEASE_HEARTBEAT_SECONDS=30

# Agent worker configuration
AGENT_RUNNER_CMD=/opt/multiagent/scripts/run_agent.sh
AGENT_TIMEOUT_SECONDS=1800
TEST_TIMEOUT_SECONDS=900
AGENT_MAX_CONCURRENT_RUNS=1
WORKTREE_ROOT=/worktrees
GITOPS_LOG_ROOT=/var/log/gitops

# Subproject base branches (for agent worktrees)
SIMA_BASE_BRANCH=develop
CANDASH_BASE_BRANCH=main
OMR_BASE_BRANCH=main
REFACTOR_BASE_BRANCH=master

# Git identity for commits
GIT_AUTHOR_NAME=GitOps Dashboard
GIT_AUTHOR_EMAIL=gitops@multiagent.local

# Dashboard
DASHBOARD_PORT=8080
BASE_URL=https://dev2.sima.adlr.ir
YOUR_ID=agent-dashboard
