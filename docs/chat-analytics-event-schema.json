{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://multiagent.example.com/schemas/chat-analytics-event@v1.json",
  "title": "Chat Analytics Event Schema v1",
  "type": "object",
  "required": ["event_name", "event_version", "timestamp_utc", "session_id_hash", "request_seq", "environment", "service_version", "correlation_id"],
  "properties": {
    "event_name": {
      "type": "string",
      "pattern": "^chat\\.(session|request|token|retrieval|tool|feedback)\\.(started|ended|completed|failed|delta|used|called|received)@v1$"
    },
    "event_version": { "type": "integer", "const": 1 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "session_id_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "request_seq": { "type": "integer", "minimum": 1 },
    "environment": { "type": "string", "enum": ["dev", "staging", "prod"] },
    "service_version": { "type": "string", "maxLength": 50 },
    "correlation_id": { "type": "string", "format": "uuid" },
    "entry_point": { "type": "string", "enum": ["web_chat", "api", "widget", "mobile"] },
    "user_tier": { "type": "string", "enum": ["anonymous", "authenticated", "premium"] },
    "locale": { "type": "string", "maxLength": 10 },
    "platform": { "type": "string", "enum": ["desktop", "mobile", "tablet", "unknown"] },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "request_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "end_reason": { "type": "string", "enum": ["user_closed", "timeout", "error", "explicit_logout"] },
    "intent_category": { "type": "string", "enum": ["job_search", "job_detail", "application", "profile", "general", "unknown"] },
    "has_context": { "type": "boolean" },
    "model_id": { "type": "string", "maxLength": 50 },
    "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
    "max_tokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "latency_ms": { "type": "integer", "minimum": 0, "maximum": 300000 },
    "prompt_tokens": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "completion_tokens": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "total_tokens": { "type": "integer", "minimum": 0, "maximum": 200000 },
    "finish_reason": { "type": "string", "enum": ["stop", "length", "tool_calls", "content_filter", "error"] },
    "tool_call_count": { "type": "integer", "minimum": 0, "maximum": 50 },
    "retrieval_used": { "type": "boolean" },
    "citations_count": { "type": "integer", "minimum": 0, "maximum": 20 },
    "error_class": { "type": "string", "enum": ["timeout", "rate_limit", "model_error", "validation_error", "network_error", "internal_error", "content_policy", "validation", "not_found", "permission_denied", "upstream_error", "internal"] },
    "error_code": { "type": "string", "maxLength": 50 },
    "retryable": { "type": "boolean" },
    "partial_tokens": { "type": "integer", "minimum": 0 },
    "token_index": { "type": "integer", "minimum": 0 },
    "delta_latency_ms": { "type": "integer", "minimum": 0 },
    "is_final": { "type": "boolean" },
    "retrieval_type": { "type": "string", "enum": ["vector", "keyword", "hybrid", "sql"] },
    "query_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "top_k": { "type": "integer", "minimum": 1, "maximum": 50 },
    "results_returned": { "type": "integer", "minimum": 0, "maximum": 50 },
    "index_name": { "type": "string", "maxLength": 50 },
    "filter_keys": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "maxItems": 10 },
    "tool_name": { "type": "string", "maxLength": 50 },
    "tool_call_id": { "type": "string", "format": "uuid" },
    "args_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "args_cardinality": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "status": { "type": "string", "enum": ["success", "error", "timeout", "rate_limited"] },
    "result_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "result_size_bytes": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "feedback_type": { "type": "string", "enum": ["thumbs_up", "thumbs_down", "rating_1_5", "free_text_flag"] },
    "rating_value": { "type": "integer", "minimum": 1, "maximum": 5 },
    "request_correlation_id": { "type": "string", "format": "uuid" },
    "has_comment": { "type": "boolean" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "event_name": { "const": "chat.session.started@v1" } } }, { "then": { "required": ["entry_point", "user_tier"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.session.ended@v1" } } }, { "then": { "required": ["duration_ms", "request_count", "end_reason"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.request.started@v1" } } }, { "then": { "required": ["has_context", "model_id"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.request.completed@v1" } } }, { "then": { "required": ["latency_ms", "prompt_tokens", "completion_tokens", "total_tokens", "finish_reason", "tool_call_count", "retrieval_used"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.request.failed@v1" } } }, { "then": { "required": ["latency_ms", "error_class", "retryable"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.token.delta@v1" } } }, { "then": { "required": ["token_index", "delta_latency_ms", "is_final"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.retrieval.used@v1" } } }, { "then": { "required": ["retrieval_type", "query_hash", "top_k", "results_returned", "latency_ms", "index_name"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.tool.called@v1" } } }, { "then": { "required": ["tool_name", "tool_call_id", "args_hash"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.tool.completed@v1" } } }, { "then": { "required": ["tool_call_id", "latency_ms", "status"] } } },
    { "if": { "properties": { "event_name": { "const": "chat.feedback.received@v1" } } }, { "then": { "required": ["feedback_type", "request_correlation_id", "has_comment"] } } }
  ]
}
